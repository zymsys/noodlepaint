{
  "name": "noodlepaint",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/sw-build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-qa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "phone": "node scripts/phone.mjs",
    "release": "npm test && npm version patch && git push --follow-tags"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.58.0",
    "fake-indexeddb": "^6.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
